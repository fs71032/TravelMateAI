# Copy to .env and adjust values (never commit .env with real secrets)

# --- Required in production ---
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Set to true only for local file:// testing
# CORS_ALLOW_FILE=false

# --- Database ---
# DATABASE_PATH=./data/travelmate.db

# --- JWT ---
JWT_EXPIRY=15m

# --- Live places (default: OpenStreetMap — free, no API key) ---
# OSM_PLACES_ENABLED=false

# --- Optional Google Places (extra data if you have a key) ---
# GOOGLE_PLACES_API_KEY=your-google-api-key

# --- Optional AI ---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Optional Redis (socket presence) ---
# REDIS_URL=redis://localhost:6379

# --- Seed admin in dev (default on when NODE_ENV != production) ---
# SEED_DEFAULT_ADMIN=true
