{
  "name": "travelmate-ai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/kill_dev_ports.cjs 5173 5174",
    "start": "npm run dev:all",
    "predev:all": "node scripts/kill_dev_ports.cjs",
    "dev:all": "npx --yes concurrently -n backend,frontend -c blue,green \"npm run backend\" \"npx --yes wait-on http://localhost:4000/api/health -t 45000 && npm run dev\"",
    "backend": "npx --yes cross-env RUN_BY_DEV_ALL=1 npm --prefix backend start",
    "kill-ports": "node scripts/kill_dev_ports.cjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "save-sample-backend": "npm --prefix backend run save-sample",
    "er:open": "powershell -NoProfile -ExecutionPolicy Bypass -File docs/open-er-diagram.ps1",
    "er:diagram": "npm --prefix backend run db:er-diagram"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.2",
    "react-router-dom": "^6.14.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.37",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.4.1"
  }
}
